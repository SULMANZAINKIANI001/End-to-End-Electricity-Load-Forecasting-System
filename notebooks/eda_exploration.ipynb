{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Electricity Load Forecasting - Exploratory Data Analysis\n",
    "\n",
    "This notebook performs EDA on the DE_LU (Germany/Luxembourg) electricity load data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "sys.path.insert(0, str(Path.cwd().parent) if Path.cwd().name == 'notebooks' else str(Path.cwd())))\n",
    "\n",
    "from src.config import settings\n",
    "from src.data import (\n",
    "    COUNTRY_TIMEZONES,\n",
    "    DataFetchError,\n",
    "    load_de_lu_export_dataset,\n",
    "    load_pakistan_csv_dataset,\n",
    ")\n",
    "\n",
    "plt.rcParams['figure.figsize'] = (14, 5)\n",
    "plt.rcParams['figure.dpi'] = 120"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 1. Load Data"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    df = load_de_lu_export_dataset()\n",
    "    source = df.attrs.get('source', 'unknown')\n",
    "    source_detail = df.attrs.get('source_detail', '')\n",
    "    print(f'Loaded {len(df):,} rows from {source}')\n",
    "    print(f'Source detail: {source_detail}')\n",
    "    print(f'Date range: {df.index.min()} to {df.index.max()}')\n",
    "except DataFetchError as e:\n",
    "    print(f'DE_LU export not available: {e}')\n",
    "    print('Falling back to Pakistan CSV for demonstration.')\n",
    "    df = load_pakistan_csv_dataset()\n",
    "    print(f'Loaded {len(df):,} rows')\n",
    "\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 2. Summary Statistics"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "load = df['load_mw']\n",
    "stats = {\n",
    "    'Count': f'{len(load):,}',\n",
    "    'Mean': f'{load.mean():,.1f} MW',\n",
    "    'Median': f'{load.median():,.1f} MW',\n",
    "    'Std Dev': f'{load.std():,.1f} MW',\n",
    "    'Min': f'{load.min():,.1f} MW',\n",
    "    'Max': f'{load.max():,.1f} MW',\n",
    "    'Q25': f'{load.quantile(0.25):,.1f} MW',\n",
    "    'Q75': f'{load.quantile(0.75):,.1f} MW',\n",
    "    'Missing': f'{load.isna().sum():,}',\n",
    "}\n",
    "pd.Series(stats, name='Load Statistics')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 3. Load Curve"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots()\n",
    "ax.plot(df.index, df['load_mw'], linewidth=0.5, color='#0f766e')\n",
    "ax.set_title('Hourly Electricity Load Over Time')\n",
    "ax.set_xlabel('Date')\n",
    "ax.set_ylabel('Load (MW)')\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 4. Weekly Seasonality"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df['hour'] = df.index.hour\n",
    "df['dayofweek'] = df.index.dayofweek\n",
    "weekly = df.groupby(['dayofweek', 'hour'])['load_mw'].mean().unstack()\n",
    "day_names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']\n",
    "weekly.index = day_names[:len(weekly)]\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "im = ax.imshow(weekly.values, aspect='auto', cmap='YlOrRd')\n",
    "ax.set_xticks(range(0, 24, 3))\n",
    "ax.set_xticklabels([f'{h}:00' for h in range(0, 24, 3)])\n",
    "ax.set_yticks(range(len(weekly)))\n",
    "ax.set_yticklabels(weekly.index)\n",
    "ax.set_title('Average Load by Day of Week and Hour (MW)')\n",
    "ax.set_xlabel('Hour of Day')\n",
    "ax.set_ylabel('Day of Week')\n",
    "plt.colorbar(im, ax=ax, label='Load (MW)')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 5. Daily Boxplot"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots()\n",
    "day_data = [df.loc[df.index.dayofweek == i, 'load_mw'].values for i in range(7)]\n",
    "bp = ax.boxplot(day_data, labels=day_names, patch_artist=True)\n",
    "for patch, color in zip(bp['boxes'], ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd', '#8c564b', '#e377c2']):\n",
    "    patch.set_facecolor(color)\n",
    "    patch.set_alpha(0.6)\n",
    "ax.set_title('Load Distribution by Day of Week')\n",
    "ax.set_ylabel('Load (MW)')\n",
    "ax.grid(True, alpha=0.3, axis='y')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 6. Missing Value Analysis"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "full_range = pd.date_range(start=df.index.min(), end=df.index.max(), freq='h', name='timestamp')\n",
    "missing_hours = full_range.difference(df.index)\n",
    "print(f'Total hours in range: {len(full_range):,}')\n",
    "print(f'Hours present in data: {len(df):,}')\n",
    "print(f'Missing hours: {len(missing_hours):,}')\n",
    "print(f'Completeness: {len(df) / len(full_range) * 100:.2f}%')\n",
    "\n",
    "if len(missing_hours) > 0 and len(missing_hours) <= 50:\n",
    "    print(f'\\nMissing timestamps:')\n",
    "    for ts in missing_hours:\n",
    "        print(f'  {ts}')\n",
    "elif len(missing_hours) > 50:\n",
    "    print(f'\\nFirst 20 missing timestamps:')\n",
    "    for ts in missing_hours[:20]:\n",
    "        print(f'  {ts}')\n",
    "    print(f'  ... and {len(missing_hours) - 20} more')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 7. Daily and Weekly Patterns"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "hourly_avg = df.groupby(df.index.hour)['load_mw'].mean()\n",
    "weekday_avg = df.loc[df.index.dayofweek < 5].groupby(df.loc[df.index.dayofweek < 5].index.hour)['load_mw'].mean()\n",
    "weekend_avg = df.loc[df.index.dayofweek >= 5].groupby(df.loc[df.index.dayofweek >= 5].index.hour)['load_mw'].mean()\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "ax.plot(hourly_avg.index, hourly_avg.values, label='All days', linewidth=2, color='#333')\n",
    "ax.plot(weekday_avg.index, weekday_avg.values, label='Weekdays', linewidth=1.5, linestyle='--', color='#1f77b4')\n",
    "ax.plot(weekend_avg.index, weekend_avg.values, label='Weekends', linewidth=1.5, linestyle=':', color='#ff7f0e')\n",
    "ax.set_title('Average Hourly Load Profile')\n",
    "ax.set_xlabel('Hour of Day')\n",
    "ax.set_ylabel('Average Load (MW)')\n",
    "ax.set_xticks(range(0, 24, 3))\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 8. Key Findings"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "peak_hour = hourly_avg.idxmax()\n",
    "trough_hour = hourly_avg.idxmin()\n",
    "weekday_weekend_diff = weekday_avg.mean() - weekend_avg.mean()\n",
    "\n",
    "print('=== Key Findings ===')\n",
    f"print(f'Peak hour:          {peak_hour}:00 ({hourly_avg[peak_hour]:,.0f} MW)')\n",
    "print(f'Trough hour:        {trough_hour}:00 ({hourly_avg[trough_hour]:,.0f} MW)')\n",
    "print(f'Peak-to-trough:    {hourly_avg[peak_hour] - hourly_avg[trough_hour]:,.0f} MW')\n",
    "print(f'Weekday avg:       {weekday_avg.mean():,.0f} MW')\n",
    "print(f'Weekend avg:       {weekend_avg.mean():,.0f} MW')\n",
    "print(f'Weekday-Weekend:   {weekday_weekend_diff:+,.0f} MW')\n",
    "print(f'Daily std range:   {df.resample(\"D\")[\"load_mw\"].mean().std():,.0f} MW')\n",
    "print(f'Coefficient of variation: {load.std() / load.mean() * 100:.1f}%')"
   ]
  }
 ],
